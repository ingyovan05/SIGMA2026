                         OBSERVACION AS observacióncancela, FECHACANCELACION AS fechacancelación, LTRIM(RTRIM(JUSTIFICACION)) AS JUSTIFICACION,
                             (SELECT        NOMBREACTIVIDADPRINCIPAL
