                         dbo.Personanombrecompleto(IDPERSONAAUTORIZA) AS PERSONAAUTORIZA, ISNULL(TM_AUTORIZA, dbo.TelefonoContacto(IDPERSONAAUTORIZA)) AS AUTORIZACEL, ISNULL(CONVERT(NCHAR(10), 
