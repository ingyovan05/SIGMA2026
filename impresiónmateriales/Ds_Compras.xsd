OC.CODIGOCENTROCOSTOSSOLIN +'-'+OC.SUBCENTROCOSTOSSOLIN as Contrato,
LTRIM(RTRIM(BG.ABREVIATURA)) + '.' + RQ.AÑO + RQ.CONSECUTIVO AS Requisición,
dbo.Proveedornombrecompleto(CCDD.IDPROVEEDOR) as Proveedor,
ltrim(rtrim(B.ABREVIATURA)) +'-'+OC.AÑO+MATO.ABREVIATURA +OC.MES+OC.CONSECUTIVO AS [Orden de Compra],
ltrim(rtrim(BE.ABREVIATURA))+'.'+EA.AÑO +EA.MES+EA.CONSECUTIVO as Entrada,
CCDD.VALORDOCUMENTO as Valor, 
CCDD.ANEXO as Anexo, 
CCDD.FECHADOCUMENTO as 'Fecha Documento',
CCDD.FECHAVENCIMIENTO as 'Fecha Vencimiento', 
CCDD.IDRELACIONDOCUMENTO,CCDD.IDDOCUMENTO
FROM            CC_DETALLEDOCUMENTO CCDD,  ITEMENTRADAALMACEN IEA, ORDENCOMPRA OC,
REQUISICION RQ,BODEGA BG,BODEGA B, MA_TIPOORDENCOMPRA MATO, ENTRADAALMACEN EA, BODEGA BE
WHERE        (IDRELACIONDOCUMENTO IS NULL) 
AND IEA.NUMEROFACTURA= CCDD.NUMERODOCUMENTO
AND IEA.IDORDENCOMPRA=OC.IDORDENCOMPRA 
AND RQ.IDREQUISICION =OC.IDREQUISICION 
AND BG.IDBODEGA =RQ.IDBODEGA 
AND B.IDBODEGA =OC.IDBODEGACOMPRA
AND MATO.CODIGOTIPOORDENCOMPRA =OC.CODIGOTIPOORDENCOMPRA
AND EA.IDENTRADAALMACEN =IEA.IDENTRADAALMACEN 
AND BE.IDBODEGA =EA.IDBODEGA </CommandText>
