                <SelectCommand>
                  <DbCommand CommandType="Text" ModifiedByUser="true">
                    <CommandText>SELECT ART.IDARTICULO, ART.NOMBREDESCRIPTIVO AS NOMBRE,
	(
		SELECT LTRIM(RTRIM(ABREVIATURA)) AS ABREVIATURA
		FROM MA_TIPOUNIDAD AS MTU
		WHERE (ART.CODIGOTIPOUNIDAD = CODIGOTIPOUNIDAD)
	) AS UNIDAD, 
	STOCK.EXISTENCIAS AS EXISTENCIAS, 
	LTRIM(RTRIM(MFM.IDFAMILIAMATERIAL)) AS FAMILIA, 
	ART.CODIGOTIPOUNIDAD
FROM ARTICULO AS ART LEFT OUTER JOIN
	CATEGORIAMATERIALES AS CTM ON ART.CODIGOCATEGORIA = CTM.CODIGOCATEGORIA LEFT OUTER JOIN
	MA_FAMILIAMATERIAL AS MFM ON CTM.IDFAMILIAMATERIAL = MFM.IDFAMILIAMATERIAL LEFT OUTER JOIN
	dbo.STOCK(@IDBODEGA) AS STOCK ON STOCK.ID=ART.IDARTICULO
WHERE (LTRIM(RTRIM(ART.NOMBREDESCRIPTIVO)) &lt;&gt; '') AND (MFM.IDFAMILIAMATERIAL = @IDFAMILIAMATERIAL)
ORDER BY ART.IDARTICULO</CommandText>
