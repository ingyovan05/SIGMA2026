                    <CommandText>SELECT        RES.IDITEMORDENCOMPRA, RES.IDORDENCOMPRA, RES.IDARTICULO, RES.IDREQUISICION, RES.IDITEMREQUISICION, RES.DESCRIPCION, RES.UNIDAD, 
                         RES.PORCENTAJEIVA, RES.CANTIDADPENDIENTE, RES.CANTIDAD, RES.VALORUNITARIO, RES.VALORDESCUENTO, RES.TIPODESCUENTO, RES.VALORTOTALITEM, 
                         BOD.IDBODEGA
FROM            (SELECT        ITOC.IDITEMORDENCOMPRA, ITOC.IDORDENCOMPRA, ITOC.IDARTICULO, ITOC.IDREQUISICION, ITOC.IDITEMREQUISICION, 
                                                    RTRIM(LTRIM(A.NOMBREDESCRIPTIVO)) AS DESCRIPCION, MATU.ABREVIATURA AS UNIDAD, CAST(CAST(ITOC.PORCENTAJEIVA AS INT) 
                                                    AS NVARCHAR(5)) AS PORCENTAJEIVA, ITRQ.CANTIDADSOLICITADA AS CANTIDADPENDIENTE, ITOC.CANTIDAD, ITOC.VALORUNITARIO, 
                                                    ITOC.VALORDESCUENTO, CASE WHEN (ITOC.APLICADESCUENTO = 'N') 
                                                    THEN 'No tiene' ELSE CASE WHEN ITOC.APLICADESCUENTO = 'T' THEN 'Valor Total' ELSE CASE WHEN (ITOC.APLICADESCUENTO = 'P') 
                                                    THEN 'Porcentaje' ELSE 'Por Unidad' END END END AS TIPODESCUENTO, 
                                                    (ITOC.CANTIDAD * ITOC.VALORUNITARIO - CASE WHEN APLICADESCUENTO = 'N' THEN 0 ELSE CASE WHEN APLICADESCUENTO = 'T' THEN VALORDESCUENTO
                                                     ELSE CASE WHEN APLICADESCUENTO = 'P' THEN (ITOC.CANTIDAD * VALORUNITARIO * (VALORDESCUENTO / 100)) 
                                                    ELSE (ITOC.CANTIDAD * VALORDESCUENTO) END END END) * (1 + ITOC.PORCENTAJEIVA / 100) AS VALORTOTALITEM
                          FROM            ITEMORDENCOMPRA AS ITOC INNER JOIN
                                                    ARTICULO AS A ON ITOC.IDARTICULO = A.IDARTICULO INNER JOIN
                                                    ITEMREQUISICION AS ITRQ ON ITOC.IDREQUISICION = ITRQ.IDREQUISICION AND ITOC.IDITEMREQUISICION = ITRQ.IDITEMREQUISICION INNER JOIN
                                                    MA_TIPOUNIDAD AS MATU ON ITRQ.CODIGOTIPOUNIDAD = MATU.CODIGOTIPOUNIDAD
                          WHERE        (ITOC.IDORDENCOMPRA = @IDORDENCOMPRA)) AS RES INNER JOIN
                         REQUISICION AS RQ ON RES.IDREQUISICION = RQ.IDREQUISICION INNER JOIN
                         BODEGA AS BOD ON RQ.IDBODEGA = BOD.IDBODEGA</CommandText>
