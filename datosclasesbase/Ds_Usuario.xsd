                <SelectCommand>
                  <DbCommand CommandType="Text" ModifiedByUser="false">
                    <CommandText>SELECT        U.IDPERSONA, U.CODIGOTIPOUSUARIO, P.IDENTIFICACION, dbo.Personanombrecompleto(U.IDPERSONA) AS NOMBRECOMPLETO, U.IDBODEGA, 
                         LTRIM(RTRIM(B.ABREVIATURA)) AS ABREVIATURA, LTRIM(RTRIM(B.NOMBRE)) AS NOMBRE, LTRIM(RTRIM(B.DIRECCION)) AS DIRECCION, 
