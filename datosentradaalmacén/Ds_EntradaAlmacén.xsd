                <SelectCommand>
                  <DbCommand CommandType="Text" ModifiedByUser="true">
                    <CommandText>SELECT     ART.IDARTICULO, ART.NOMBREDESCRIPTIVO AS NOMBRE,
                          (SELECT     LTRIM(RTRIM(ABREVIATURA)) AS ABREVIATURA
                            FROM          MA_TIPOUNIDAD AS MTU
                            WHERE      (ART.CODIGOTIPOUNIDAD = CODIGOTIPOUNIDAD)) AS UNIDAD, ISNULL
                          ((SELECT     SUM(EXISTENCIA) AS Expr1
                              FROM         (SELECT     IEA.IDARTICULO, SUM(IEA.CANTIDAD) AS EXISTENCIA
                                                     FROM          ITEMENTRADAALMACEN AS IEA INNER JOIN
                                                                            ENTRADAALMACEN AS EA ON IEA.IDENTRADAALMACEN = EA.IDENTRADAALMACEN
                                                     WHERE      (IEA.IDARTICULO = ART.IDARTICULO) AND (EA.IDBODEGA = @IDBODEGA)
                                                     GROUP BY IEA.IDARTICULO
                                                     UNION
                                                     SELECT     ISA.IDARTICULO, SUM(ISA.CANTIDAD) * - 1 AS EXISTENCIA
                                                     FROM         ITEMSALIDAALMACEN AS ISA INNER JOIN
                                                                           SALIDAALMACEN AS SA ON ISA.IDSALIDAALMACEN = SA.IDSALIDAALMACEN
                                                     WHERE     (ISA.IDARTICULO = ART.IDARTICULO) AND (SA.IDBODEGA = @IDBODEGA)
                                                     GROUP BY ISA.IDARTICULO) AS EXISTENCIAS
                              GROUP BY IDARTICULO), 0) AS EXISTENCIAS, LTRIM(RTRIM(MFM.IDFAMILIAMATERIAL)) AS FAMILIA, ART.CODIGOTIPOUNIDAD
FROM         ARTICULO AS ART LEFT OUTER JOIN
                      CATEGORIAMATERIALES AS CTM ON ART.CODIGOCATEGORIA = CTM.CODIGOCATEGORIA LEFT OUTER JOIN
                      MA_FAMILIAMATERIAL AS MFM ON CTM.IDFAMILIAMATERIAL = MFM.IDFAMILIAMATERIAL
ORDER BY ART.IDARTICULO</CommandText>
